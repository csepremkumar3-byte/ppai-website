# ==============================================================================
# PPAI / IJPP PORTAL ENVIRONMENT CONFIGURATION (.env)
# Rename or copy this file to .env and fill in your production credentials
# ==============================================================================

# Security
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_ENV=production
ALLOWED_HOSTS=127.0.0.1,localhost,ppai.org.in,www.ppai.org.in

# Email Configuration (Resend)
# 1. Sign up at https://resend.com
# 2. Add and verify your domain (e.g. ppai.org.in)
# 3. Create an API Key (starts with re_) and paste below:
RESEND_API_KEY=re_your_api_key_here

# Email Headers
DEFAULT_FROM_EMAIL=IJPP Editorial Office <editor@ppai.org.in>
CHIEF_EDITOR_EMAIL=editor@ppai.org.in
SERVER_EMAIL=editor@ppai.org.in
